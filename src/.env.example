# Copy to .env (git-ignored) or export in your shell. Only SIGNING_KEY is required.
SIGNING_KEY=local-dev-signing-key   # the API refuses to start without one
RECORDS_PATH=                       # SQLite file for records and the downlink queue; empty = in memory
BASELINES_PATH=                     # override data/nasa/osdr_inspiration4/processed/baselines.json
LINK_PRESET=                        # earth delay preset: leo, moon, mars_near, mars_far
LINK_ONE_WAY_S=                     # or an explicit one-way light delay in seconds
LLM_ENABLED=0                       # 1 enables the optional local LLM pipeline (Ollama, loopback only)
OLLAMA_HOST=http://127.0.0.1:11434
LLM_MODEL=
LLM_TIMEOUT_S=
NASA_API_KEY=                       # optional, for api.nasa.gov DONKI fetches
SEED=42
